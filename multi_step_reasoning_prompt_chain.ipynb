    "## 9. Failure inspection\n",
    "\n",
    "Look at an actual broken run. With `flan-t5-base` you should expect to see the\n",
    "decomposition step produce something that is not a valid decomposition, and\n",
    "everything downstream inherit that."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def inspect(problem_id: str, method: str = \"chain\"):\n",
    "    for t in transcripts:\n",
    "        if t[\"problem\"] == problem_id and t[\"method\"] == method:\n",
    "            raw = t[\"raw\"]\n",
    "            display(Markdown(f\"### {problem_id} — {method}\"))\n",
    "            if \"subtasks\" in raw:\n",
    "                display(Markdown(f\"**Step 1 — decomposition**\\n\\n```\\n{raw['subtasks']}\\n```\"))\n",
    "                display(Markdown(f\"**Step 2 — solutions**\\n\\n```\\n{raw['solutions']}\\n```\"))\n",
    "            display(Markdown(f\"**Final output**\\n\\n```\\n{raw['final_answer']}\\n```\"))\n",
    "            display(Markdown(f\"**Parsed:** `{t['parsed']}`\"))\n",
    "            display(Markdown(f\"**Per-field correctness:** `{t['grade']['per_field']}`\"))\n",
    "            return\n",
    "    print(\"Not found.\")\n",
    "\n",
    "\n",
    "inspect(\"P1_product_mix\", \"chain\")"
   ]
